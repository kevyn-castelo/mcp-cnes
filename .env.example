# Copie apenas os valores necessários para o ambiente do cliente MCP.
MCP_CNES_DATA_DIR=downloads
MCP_CNES_DATABASE_PATH=downloads/cnes.sqlite3
MCP_CNES_OUTPUT_DIR=downloads/exports
MCP_CNES_MAX_CSV_SIZE_BYTES=104857600
MCP_CNES_BATCH_RETENTION_COUNT=5
# Lista opcional de nomes de CSV separados por vírgula.
MCP_CNES_ALLOWED_CSV_FILES=
# Ingestão remota pelo catálogo oficial do Portal SUS.
MCP_CNES_REMOTE_DIR=downloads/remote
MCP_CNES_REMOTE_CACHE_DIR=downloads/cache
MCP_CNES_REMOTE_CACHE_TTL_SECONDS=86400
MCP_CNES_REMOTE_MAX_DOWNLOAD_BYTES=104857600
MCP_CNES_REMOTE_MAX_CONCURRENCY=2
MCP_CNES_REMOTE_USER_AGENT=mcp-cnes/0.1 (+https://github.com/kevyn-castelo/mcp-cnes)
